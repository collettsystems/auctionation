{
  "name": "auctionation",
  "version": "0.1.0",
  "private": true,
  "description": "Commercial multi-tenant silent auction platform with iframe embedding.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:apps && npm run build:workers",
    "build:packages": "npm run build --workspace @auctionation/shared --workspace @auctionation/email --workspace @auctionation/notifications",
    "build:apps": "npm run build --workspace @auctionation/admin --workspace @auctionation/api --workspace @auctionation/embed --workspace @auctionation/widget-demo",
    "build:workers": "npm run build --workspace @auctionation/notifications-worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docker:prod:config": "docker compose -f docker-compose.prod.yml config",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "dev:api": "npm --workspace @auctionation/api run dev",
    "dev:admin": "npm --workspace @auctionation/admin run dev",
    "dev:embed": "npm --workspace @auctionation/embed run dev",
    "dev:widget-demo": "npm --workspace @auctionation/widget-demo run dev",
    "dev:notifications": "npm --workspace @auctionation/notifications-worker run dev",
    "clean": "find apps packages workers -type d \\( -name dist -o -name node_modules \\) -prune -exec rm -rf {} +",
    "db:local:up": "docker compose up -d postgres",
    "db:local:down": "docker compose down",
    "db:local:reset": "docker compose down -v && docker compose up -d postgres",
    "db:schema:apply": "psql \"${DATABASE_URL:-postgresql://auctionation:auctionation@localhost:5432/auctionation}\" -f infra/sql/001_initial_schema.sql"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
